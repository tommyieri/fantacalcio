    let myRoster = JSON.parse(localStorage.getItem('myFantaRosterMultiLink')) || [];
    let activeRole = 'ALL';
    let activeTag = 'ALL';

    function initGridDropdowns() {
      const selectA = document.getElementById('grid-team-a');
      const selectB = document.getElementById('grid-team-b');
      selectA.innerHTML = '';
      selectB.innerHTML = '';
      
      teamsList.forEach(t => {
        selectA.innerHTML += `<option value="${t}">${t}</option>`;
        selectB.innerHTML += `<option value="${t}">${t}</option>`;
      });
      selectA.value = 'INT';
      selectB.value = 'MIL';
      calculateGridPairing();
    }

    function calculateGridPairing() {
      const a = document.getElementById('grid-team-a').value;
      const b = document.getElementById('grid-team-b').value;
      if (a === b) {
        document.getElementById('grid-result-val').innerText = 'Stessa';
        document.getElementById('grid-result-text').innerText = 'Seleziona due squadre distinte';
        return;
      }
      const val = gridMatrix[a] ? gridMatrix[a][b] : '-';
      document.getElementById('grid-result-val').innerText = val;
      
      if (val === 0) {
        document.getElementById('grid-result-text').innerText = 'Perfetto (100% Alternanza Casa)';
      } else if (val <= 5) {
        document.getElementById('grid-result-text').innerText = 'Incrocio Eccellente';
      } else if (val <= 7) {
        document.getElementById('grid-result-text').innerText = 'Incrocio Buono / Consigliato';
      } else {
        document.getElementById('grid-result-text').innerText = 'Incrocio Sconsigliato';
      }
    }

    function calculateDynamicBudget() {
      const initialBudget = 500;
      const spent = myRoster.reduce((sum, p) => sum + p.paid, 0);
      const remainingBudget = initialBudget - spent;
      
      const counts = { P: 0, D: 0, C: 0, A: 0 };
      myRoster.forEach(p => counts[p.role]++);

      const missing = {
        P: Math.max(0, 2 - counts.P),
        D: Math.max(0, 8 - counts.D),
        C: Math.max(0, 8 - counts.C),
        A: Math.max(0, 6 - counts.A)
      };
      
      const totalMissing = missing.P + missing.D + missing.C + missing.A;
      const reserveForOthers = Math.max(0, totalMissing - 1);

      const maxBidA = missing.A > 0 ? Math.max(1, remainingBudget - reserveForOthers) : 0;
      const maxBidC = missing.C > 0 ? Math.max(1, Math.min(Math.round(remainingBudget * 0.40), remainingBudget - reserveForOthers)) : 0;

      document.getElementById('budget-left').innerText = remainingBudget;
      document.getElementById('slots-count').innerText = myRoster.length;
      document.getElementById('max-bid-a').innerText = maxBidA;
      document.getElementById('max-bid-c').innerText = maxBidC;
      document.getElementById('role-summary-badge').innerText = `${counts.P}/2 P • ${counts.D}/8 D • ${counts.C}/8 C • ${counts.A}/6 A`;

      return { remainingBudget, missing };
    }

    function renderList() {
      const query = document.getElementById('search-input').value.toLowerCase();
      const tbody = document.getElementById('players-table-body');
      tbody.innerHTML = '';

      const { remainingBudget } = calculateDynamicBudget();
      const budgetFactor = Math.max(0.2, remainingBudget / 500);

      const filtered = playersDB
        .filter(p => activeRole === 'ALL' || p.role === activeRole)
        .filter(p => activeTag === 'ALL' || p.tag.includes(activeTag) || p.status.includes(activeTag))
        .filter(p => p.name.toLowerCase().includes(query) || p.team.toLowerCase().includes(query) || p.status.toLowerCase().includes(query) || p.note.toLowerCase().includes(query));

      filtered.forEach(p => {
        const isBought = myRoster.some(r => r.id === p.id);
        const dynamicMax = Math.max(1, Math.round(p.baseMax * budgetFactor));

        const tr = document.createElement('tr');
        tr.className = isBought ? 'opacity-35 bg-slate-950/60' : 'hover:bg-slate-800/40 transition duration-150';
        
        const roleColor = p.role === 'P' ? 'text-amber-400' : p.role === 'D' ? 'text-emerald-400' : p.role === 'C' ? 'text-blue-400' : 'text-rose-400';
        
        let badgeStyle = 'bg-indigo-950 text-indigo-300 border border-indigo-800/60';
        if (p.tag === 'TOP' || p.status.includes('SUPER TOP')) {
          badgeStyle = 'bg-amber-950 text-amber-300 border border-amber-800/60 font-bold';
        } else if (p.tag === 'RIGORISTA') {
          badgeStyle = 'bg-emerald-950 text-emerald-300 border border-emerald-800/60 font-bold';
        } else if (p.tag === '1 CR') {
          badgeStyle = 'bg-teal-950 text-teal-300 border border-teal-800/60';
        } else if (p.tag === 'RISCHIO') {
          badgeStyle = 'bg-rose-950 text-rose-300 border border-rose-800/60';
        }

        tr.innerHTML = `
          <td class="p-3 font-black ${roleColor}">${p.role}</td>
          <td class="p-3 font-semibold text-white">${p.name}</td>
          <td class="p-3 text-slate-400">${p.team}</td>
          <td class="p-3 text-center">
            <span class="inline-block px-2 py-0.5 rounded text-[11px] font-bold bg-slate-800/60 text-slate-300 border border-slate-700/50">${p.fvm} / ${p.quot}</span>
          </td>
          <td class="p-3">
            <span class="text-[10px] px-2 py-0.5 rounded-md uppercase tracking-wider ${badgeStyle}">${p.status}</span>
            <p class="text-[11px] text-slate-400 mt-1">${p.note}</p>
          </td>
          <td class="p-3 text-center font-black text-amber-300 text-sm">${dynamicMax} cr</td>
          <td class="p-3 text-right">
            ${isBought ? '<span class="text-[11px] text-slate-500 font-bold tracking-wider">PRESO</span>' : `<button onclick="buyPlayer(${p.id}, ${dynamicMax})" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs px-3 py-1.5 rounded-lg font-bold shadow-md hover:shadow-indigo-500/20 transition">Acquista</button>`}
          </td>
        `;
        tbody.appendChild(tr);
      });

      renderRoster();
    }

    function buyPlayer(id, suggestedMax) {
      const player = playersDB.find(p => p.id === id);
      const paidStr = prompt(`A quanto hai acquistato ${player.name}?\nPrezzo max consigliato attuale: ${suggestedMax} crediti.`, suggestedMax);
      if (paidStr === null) return;
      const paid = parseInt(paidStr, 10);
      if (isNaN(paid) || paid < 1) {
        alert("Inserisci un importo valido (minimo 1 credito).");
        return;
      }

      myRoster.push({ ...player, paid });
      localStorage.setItem('myFantaRosterMultiLink', JSON.stringify(myRoster));
      renderList();
    }

    function removePlayer(index) {
      myRoster.splice(index, 1);
      localStorage.setItem('myFantaRosterMultiLink', JSON.stringify(myRoster));
      renderList();
    }

    function renderRoster() {
      const rosterDiv = document.getElementById('roster-list');
      rosterDiv.innerHTML = '';
      if (myRoster.length === 0) {
        rosterDiv.innerHTML = '<div class="text-center py-8 text-slate-500 text-xs italic">Nessun calciatore registrato in rosa.</div>';
        return;
      }
      myRoster.forEach((p, idx) => {
        const item = document.createElement('div');
        item.className = 'flex justify-between items-center bg-slate-950/80 p-2 rounded-xl border border-slate-800 text-xs';
        const roleColor = p.role === 'P' ? 'text-amber-400' : p.role === 'D' ? 'text-emerald-400' : p.role === 'C' ? 'text-blue-400' : 'text-rose-400';
        item.innerHTML = `
          <div class="flex items-center gap-2 truncate pr-2">
            <span class="font-black ${roleColor}">${p.role}</span>
            <span class="font-semibold text-slate-200 truncate">${p.name}</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-emerald-400 font-black">${p.paid} cr</span>
            <button onclick="removePlayer(${idx})" class="text-slate-500 hover:text-rose-400 transition" title="Rimuovi"><i class="fa-solid fa-trash-can"></i></button>
          </div>
        `;
        rosterDiv.appendChild(item);
      });
    }

    function filterRole(role) {
      activeRole = role;
      document.querySelectorAll('.role-btn').forEach(btn => {
        btn.classList.remove('bg-indigo-600');
        btn.classList.add('bg-slate-800');
      });
      event.target.classList.remove('bg-slate-800');
      event.target.classList.add('bg-indigo-600');
      renderList();
    }

    function setTagFilter(tag) {
      activeTag = tag;
      document.querySelectorAll('.tag-filter-btn').forEach(btn => {
        btn.classList.remove('ring-2', 'ring-indigo-500', 'bg-slate-700');
      });
      event.target.classList.add('ring-2', 'ring-indigo-500', 'bg-slate-700');
      renderList();
    }

    function resetAuction() {
      if (confirm("Vuoi davvero azzerare l'asta e resettare tutti i crediti?")) {
        myRoster = [];
        localStorage.removeItem('myFantaRosterMultiLink');
        renderList();
      }
    }

    document.getElementById('search-input').addEventListener('input', renderList);
    initGridDropdowns();
    renderList();
  </script>
</body>
</html>
